// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  org_admin
  member
}

enum UserStatus {
  active
  disabled
}

/// Disciplina de la competencia / liga (Prode fútbol vs F1).
enum CompetitionDiscipline {
  football
  f1
}

/// Qué competiciones pueden jugar los usuarios de una empresa B2B.
enum CompanyCompetitionScope {
  football
  f1
  all
}

model Company {
  id        String   @id @default(cuid())
  name      String
  /// Identificador único para URLs y API (ej. acme-corp)
  slug      String   @unique
  /// Cupos contratados (empleados + admin de la org; no aplica a la org interna de plataforma)
  seatLimit Int      @default(50)
  /// Máx. competencias/ligas que la empresa puede crear (null = sin tope extra; super admin)
  competitionLimit Int?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt DateTime @default(now())

  users         User[]
  invitations   Invitation[]
  aiConfig      AiConfig?
  companyConfig CompanyConfig?
  competitions  Competition[]
}

model CompanyConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  anonymizationEnabled Boolean @default(true)
  /// Mundial (football), F1 o ambas. Pool público suele usar `all`.
  competitionScope   CompanyCompetitionScope @default(all)
  updatedAt          DateTime @updatedAt
}

/// Ajustes globales de plataforma (fila única id = "default").
model PlatformConfig {
  id                      String                  @id @default("default")
  defaultCompetitionScope CompanyCompetitionScope @default(all)
  updatedAt               DateTime                @updatedAt
}

model AiConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider  String   @default("openai")
  model     String   @default("gpt-4o-mini")
  baseUrl   String?
  apiKeyEnc String?
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Null si la cuenta es solo Google u otros flujos sin contraseña local.
  passwordHash String?
  fullName     String?
  role         UserRole   @default(member)
  status       UserStatus @default(active)
  /// Si true, no aparece en rankings globales ni de liga (super admin).
  hiddenFromRankings Boolean @default(false)
  tokenVersion Int        @default(0)
  createdAt    DateTime   @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  oauthAccounts           OAuthAccount[]
  f1Predictions           F1Prediction[]
  loginEvents             LoginEvent[]
  promptLogs              PromptLog[]
  predictions             Prediction[]
  predictionHistory       PredictionHistory[]
  prodeChampionPrediction ProdeChampionPrediction?
  prodeGuidelines         ProdeGuidelines?
  invitationsSent         Invitation[] @relation("InvitationInviter")
  competitionInvitesSent    CompetitionInvitation[] @relation("CompetitionInviteInviter")
  competitionsCreated     Competition[] @relation("CompetitionCreator")
  competitionMemberships  CompetitionMember[]
  aiGenerationBatches     AiGenerationBatch[]

  @@index([companyId])
}

/// Diagnóstico persistido de un lote de generación Prode con IA (super admin).
model AiGenerationBatch {
  batchId    String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  phaseLabel String?
  requested  Int
  parsed     Int
  saved      Int
  status     String
  provider   String?
  model      String?
  diagnostics Json

  @@index([userId])
  @@index([createdAt])
}

/// Cuenta vinculada a Google (sub del proveedor).
model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum CompetitionMemberRole {
  competition_admin
  member
}

/// Liga / competencia: mismas predicciones globales; ranking acotado a miembros.
model Competition {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  discipline    CompetitionDiscipline @default(football)
  /// Código alfanumérico para unirse (ej. MUNDIAL-IA-A1B2C3); único en toda la plataforma.
  inviteCode    String   @unique
  /// Reglas o contexto visible para miembros (ej. «Solo equipo Ventas»).
  description   String?
  /// Emoji o marcador visual corto (opcional).
  emoji         String?
  /// URL de imagen de cabecera (opcional; sin hosting propio, pegá un enlace público).
  coverImageUrl String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User     @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  maxMembers    Int      @default(10)
  createdAt     DateTime @default(now())

  members                CompetitionMember[]
  emailInvitations       CompetitionInvitation[]

  @@index([companyId])
  @@index([createdById])
}

/// Invitación por email a una liga (sin alta B2B); el destinatario crea cuenta en pool público o reclama logueado.
model CompetitionInvitation {
  id            String    @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  email         String
  tokenHash     String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  invitedById   String?
  invitedBy     User?     @relation("CompetitionInviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?

  @@index([competitionId])
  @@index([email])
}

model CompetitionMember {
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CompetitionMemberRole @default(member)
  joinedAt      DateTime @default(now())

  @@id([competitionId, userId])
  @@index([userId])
}

/// Invitación por email a una empresa (B2B). El token en el enlace es distinto del hash guardado.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

model ProdeGuidelines {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pautas obligatorias por etapa de generación (Laboratorio)
  textGroups    String @default("")
  textRoundOf32 String @default("")
  textKnockout  String @default("")
  /// Pautas F1 por carrera: clave = `sessionKey` OpenF1 (string), valor = texto del Laboratorio.
  f1RaceGuidelines Json @default("{}")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Gran Premio / carrera (datos OpenF1).
model F1Race {
  id               String   @id @default(cuid())
  sessionKey       Int      @unique
  meetingKey       Int
  year             Int
  roundOrder       Int      @default(0)
  sessionName      String
  circuitShortName String?
  countryName      String?
  raceStartAt      DateTime
  /// Resultado oficial top 10: [{ "position": 1, "driverNumber": 1 }, ...]
  resultTop10      Json?
  lastSyncedAt     DateTime?

  predictions F1Prediction[]

  @@index([year, raceStartAt])
}

model F1Prediction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceId     String
  race       F1Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  /// 10 posiciones (P1..P10): número de piloto OpenF1 o null si aún no definido.
  placements Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, raceId])
  @@index([raceId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PromptLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  provider  String
  model     String?
  promptText   String
  responseText String
  tokensIn     Int?
  tokensOut    Int?

  /// Mismo UUID que el lote en PredictionHistory (generación Prode por IA)
  batchId String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, batchId])
}

enum MatchStage {
  group
  roundOf32
  roundOf16
  quarterFinal
  semiFinal
  thirdPlace
  final
}

model Match {
  id       String     @id @default(cuid())
  stage    MatchStage @default(group)
  /// Grupo A–L solo en fase de grupos (Mundial 2026)
  groupCode String?
  teamA    String
  teamB    String
  kickoffAt DateTime
  resultScoreA Int?
  resultScoreB Int?

  createdAt DateTime @default(now())

  predictions        Prediction[]
  predictionHistory  PredictionHistory[]

  @@index([kickoffAt])
}

enum PredictionHistoryKind {
  match
  champion
}

/// Registro append-only de cambios de predicción; una fila por usuario (no compartido)
model PredictionHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind PredictionHistoryKind

  matchId String?
  match   Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  scoreA  Int?
  scoreB  Int?

  champion String?
  runnerUp String?

  source     String  // "manual" | "ai"
  batchId    String?
  phaseLabel String? // p. ej. groups, roundOf32, knockout

  @@index([userId, createdAt(sort: Desc)])
  @@index([batchId])
}

model Prediction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  scoreA    Int
  scoreB    Int

  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId String
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model ProdeChampionPrediction {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  champion  String
  runnerUp  String
  updatedAt DateTime @updatedAt
}
