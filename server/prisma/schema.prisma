// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  org_admin
  member
}

enum UserStatus {
  active
  disabled
}

model Company {
  id        String   @id @default(cuid())
  name      String
  /// Identificador único para URLs y API (ej. acme-corp)
  slug      String   @unique
  /// Cupos contratados (empleados + admin de la org; no aplica a la org interna de plataforma)
  seatLimit Int      @default(50)
  /// Máx. competencias/ligas que la empresa puede crear (null = sin tope extra; super admin)
  competitionLimit Int?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt DateTime @default(now())

  users         User[]
  invitations   Invitation[]
  aiConfig      AiConfig?
  companyConfig CompanyConfig?
  competitions  Competition[]
}

model CompanyConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  anonymizationEnabled Boolean @default(true)
  updatedAt          DateTime @updatedAt
}

model AiConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider  String   @default("openai")
  model     String   @default("gpt-4o-mini")
  baseUrl   String?
  apiKeyEnc String?
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Null si el usuario solo entra con OAuth (Google / Meta / Microsoft)
  passwordHash String?
  fullName     String?
  role         UserRole   @default(member)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  oauthAccounts           OAuthAccount[]
  loginEvents             LoginEvent[]
  promptLogs              PromptLog[]
  predictions             Prediction[]
  predictionHistory       PredictionHistory[]
  prodeChampionPrediction ProdeChampionPrediction?
  prodeGuidelines         ProdeGuidelines?
  invitationsSent         Invitation[] @relation("InvitationInviter")
  competitionsCreated     Competition[] @relation("CompetitionCreator")
  competitionMemberships  CompetitionMember[]

  @@index([companyId])
}

enum CompetitionMemberRole {
  competition_admin
  member
}

/// Liga / competencia: mismas predicciones globales; ranking acotado a miembros.
model Competition {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  maxMembers  Int      @default(10)
  createdAt   DateTime @default(now())

  members CompetitionMember[]

  @@index([companyId])
  @@index([createdById])
}

model CompetitionMember {
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CompetitionMemberRole @default(member)
  joinedAt      DateTime @default(now())

  @@id([competitionId, userId])
  @@index([userId])
}

/// Invitación por email a una empresa (B2B). El token en el enlace es distinto del hash guardado.
model Invitation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

/// Cuentas vinculadas a proveedores OAuth (sub / id del proveedor)
model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model ProdeGuidelines {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pautas obligatorias por etapa de generación (Laboratorio)
  textGroups    String @default("")
  textRoundOf32 String @default("")
  textKnockout  String @default("")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model LoginEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PromptLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  provider  String
  model     String?
  promptText   String
  responseText String
  tokensIn     Int?
  tokensOut    Int?

  /// Mismo UUID que el lote en PredictionHistory (generación Prode por IA)
  batchId String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, batchId])
}

enum MatchStage {
  group
  roundOf32
  roundOf16
  quarterFinal
  semiFinal
  thirdPlace
  final
}

model Match {
  id       String     @id @default(cuid())
  stage    MatchStage @default(group)
  /// Grupo A–L solo en fase de grupos (Mundial 2026)
  groupCode String?
  teamA    String
  teamB    String
  kickoffAt DateTime
  resultScoreA Int?
  resultScoreB Int?

  createdAt DateTime @default(now())

  predictions        Prediction[]
  predictionHistory  PredictionHistory[]

  @@index([kickoffAt])
}

enum PredictionHistoryKind {
  match
  champion
}

/// Registro append-only de cambios de predicción; una fila por usuario (no compartido)
model PredictionHistory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind PredictionHistoryKind

  matchId String?
  match   Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  scoreA  Int?
  scoreB  Int?

  champion String?
  runnerUp String?

  source     String  // "manual" | "ai"
  batchId    String?
  phaseLabel String? // p. ej. groups, roundOf32, knockout

  @@index([userId, createdAt(sort: Desc)])
  @@index([batchId])
}

model Prediction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  scoreA    Int
  scoreB    Int

  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId String
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model ProdeChampionPrediction {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  champion  String
  runnerUp  String
  updatedAt DateTime @updatedAt
}
