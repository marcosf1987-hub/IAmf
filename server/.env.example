PORT=4000
DATABASE_URL="postgresql://rrhhia:1234@localhost:5432/rrhhia_prode?schema=public"
JWT_SECRET="dev_secret_change_me"
# Días (ej. 7d) o segundos numéricos (ej. 604800). En Railway puede omitirse (default 7 días).
JWT_EXPIRES_IN="7d"

# IA (marca blanca: OpenAI u otro compatible)
OPENAI_API_KEY="sk-..."
AI_MODEL="gpt-4o-mini"
# AI_BASE_URL="https://api.openai.com/v1"  # opcional, para otro proveedor

# OAuth (login social). URLs de callback en cada consola: {OAUTH_PUBLIC_BASE_URL}/auth/oauth/google/callback (y facebook / microsoft)
# FRONTEND_URL = URL pública del frontend (ej. https://tu-app.up.railway.app) para redirigir tras el login
# OAUTH_PUBLIC_BASE_URL = URL pública del backend (misma que usan los usuarios para la API)
FRONTEND_URL="http://localhost:5173"
OAUTH_PUBLIC_BASE_URL="http://localhost:4000"
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
# Meta for Developers → Tu app → Facebook Login → Configuración
OAUTH_FACEBOOK_APP_ID=""
OAUTH_FACEBOOK_APP_SECRET=""
# Azure Portal → App registrations → tu app → Certificates & secrets + Authentication (redirect URI)
OAUTH_MICROSOFT_CLIENT_ID=""
OAUTH_MICROSOFT_CLIENT_SECRET=""

# Resultados y nombres de equipos (football-data.org, plan gratuito ~10 req/min). Auto-sync cada 5 min si hay API key.
# Rellena TBD, slots de grupos (1A/2B) y cruces (R32-1, R16-1…) cuando la API ya publica los rivales reales.
# FOOTBALL_DATA_API_KEY=""
# Cada cuántos ms sincronizar (default 300000 = 5 min). 0 = solo sync manual POST /admin/sync-match-results
# FOOTBALL_DATA_AUTO_SYNC_INTERVAL_MS=300000
# true = escanear todas las filas Match y todos los partidos API (debug). Por defecto solo filas pendientes + ventana temporal.
# FOOTBALL_DATA_SYNC_FULL_SCAN=false
